{
  "_comment": [
    "Canonical, machine-checkable repository hardening policy for Ampersand/CrossInput.",
    "scripts/check-workflow-policy.py enforces this statically in CI and, with --live,",
    "compares it against the actual GitHub ruleset / security configuration.",
    "Changing anything here is a deliberate control change and must be reviewed as such."
  ],
  "required_status_checks": [
    {
      "context": "macOS App Build + Test",
      "workflow": "ci.yml",
      "job": "macos-app"
    },
    {
      "context": "Android Helper Build + Test",
      "workflow": "ci.yml",
      "job": "android-helper"
    },
    {
      "context": "Documentation Validation",
      "workflow": "ci.yml",
      "job": "markdown"
    },
    {
      "context": "Evidence & Tooling Validation",
      "workflow": "ci.yml",
      "job": "scripts"
    },
    {
      "context": "failure-triage",
      "workflow": "failure-triage.yml",
      "job": "failure-triage",
      "trigger": "pull_request_target"
    }
  ],
  "protected_branch": "main",
  "branch_ruleset": {
    "enforcement": "active",
    "allow_bypass_actors": false,
    "strict_required_status_checks_policy": true,
    "allowed_merge_methods": [
      "squash"
    ],
    "require_extra_approval_for_unattributed_changes": true,
    "required_rule_types": [
      "deletion",
      "non_fast_forward",
      "required_linear_history",
      "pull_request",
      "required_status_checks"
    ]
  },
  "tag_ruleset": {
    "ref_pattern": "refs/tags/v*",
    "enforcement": "active",
    "allow_bypass_actors": false,
    "required_rule_types": [
      "deletion",
      "update"
    ]
  },
  "codeql_authority": "custom-workflow",
  "actions_policy": {
    "sha_pinning_required": true,
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "workflows_allowed_write_permissions": {
    "release.yml": [
      "contents"
    ],
    "codeql.yml": [
      "security-events"
    ],
    "pr-labeler.yml": [
      "pull-requests",
      "issues"
    ],
    "issue-labeler.yml": [
      "issues"
    ],
    "hardening-audit.yml": [
      "issues"
    ]
  },
  "staged_status_checks": [
    {
      "context": "Dependency Review",
      "workflow": "dependency-review.yml",
      "job": "review",
      "promotion": "Promote only after ordinary PR reliability and live Dependency Graph support. Dependency Review is PR-diff-scoped and has no merged-main producer; after promotion, verify the atomic checked-in/live ruleset state by fresh readback."
    }
  ],
  "workflow_static_analysis": {
    "required_in_context": "Evidence & Tooling Validation",
    "script": "scripts/check-actions-security.sh",
    "tools": {
      "actionlint": "1.7.12",
      "zizmor": "1.30.0"
    },
    "negative_control": true
  },
  "repository_full_name": "luceat-lux-vestra/crossinput",
  "codeql_coverage": {
    "authority": "custom-workflow",
    "active_languages": [
      "actions",
      "python",
      "swift"
    ],
    "exceptions": [
      {
        "surface": "java-kotlin",
        "disposition": "temporarily unavailable",
        "evidence": "github/codeql-action v4.38.1 managed CodeQL CLI 2.27.0 rejects the maintained Kotlin 2.4.20 compiler path as too recent",
        "forbidden_workaround": "Do not use an external/nightly tools override or downgrade Kotlin solely to obtain a green advisory scanner",
        "reassessment_trigger": "Issue #157: restore only when the stable action-managed bundle accepts Kotlin 2.4.20 and exact-head extraction/analyze/upload succeeds"
      }
    ]
  }
}

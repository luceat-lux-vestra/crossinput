{
  "_comment": [
    "Canonical, machine-checkable repository hardening policy for Ampersand/CrossInput.",
    "scripts/check-workflow-policy.py enforces this statically in CI and, with --live,",
    "compares it against the actual GitHub ruleset / security configuration.",
    "Changing anything here is a deliberate control change and must be reviewed as such."
  ],
  "required_status_checks": [
    {
      "context": "Merge Gate",
      "workflow": "ci.yml",
      "job": "mergeGate",
      "components": [
        {
          "job": "macos-app",
          "name": "macOS App Build + Test"
        },
        {
          "job": "android-helper",
          "name": "Android Helper Build + Test"
        },
        {
          "job": "markdown",
          "name": "Documentation Validation"
        },
        {
          "job": "scripts",
          "name": "Evidence & Tooling Validation"
        },
        {
          "job": "dependencyReview",
          "name": "Dependency Review"
        }
      ]
    }
  ],
  "protected_branch": "main",
  "branch_ruleset": {
    "enforcement": "active",
    "allow_bypass_actors": false,
    "strict_required_status_checks_policy": true,
    "allowed_merge_methods": [
      "squash"
    ],
    "require_extra_approval_for_unattributed_changes": true,
    "required_rule_types": [
      "deletion",
      "non_fast_forward",
      "required_linear_history",
      "pull_request",
      "required_status_checks"
    ]
  },
  "tag_ruleset": {
    "ref_pattern": "refs/tags/v*",
    "enforcement": "active",
    "allow_bypass_actors": false,
    "required_rule_types": [
      "deletion",
      "update"
    ]
  },
  "codeql_authority": "custom-workflow",
  "actions_policy": {
    "sha_pinning_required": true,
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "workflows_allowed_write_permissions": {
    "release.yml": [
      "contents",
      "id-token",
      "attestations"
    ],
    "codeql.yml": [
      "security-events"
    ],
    "pr-labeler.yml": [
      "pull-requests",
      "issues"
    ],
    "issue-labeler.yml": [
      "issues"
    ],
    "hardening-audit.yml": [
      "issues"
    ]
  },
  "staged_status_checks": [],
  "workflow_static_analysis": {
    "required_in_context": "Evidence & Tooling Validation",
    "script": "scripts/check-actions-security.sh",
    "tools": {
      "actionlint": "1.7.12",
      "zizmor": "1.30.0"
    },
    "negative_control": true
  },
  "repository_full_name": "luceat-lux-vestra/crossinput",
  "codeql_coverage": {
    "authority": "custom-workflow",
    "active_languages": [
      "actions",
      "java-kotlin",
      "python",
      "swift"
    ],
    "exceptions": []
  },
  "release_provenance": {
    "workflow": "release.yml",
    "job": "dmg",
    "recovery_ref": "exact immutable v* tag",
    "artifact": "DMG",
    "attestation": "GitHub artifact build provenance",
    "attestation_action": "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6",
    "mutation_order": "verify source/artifact -> attest -> publish -> readback",
    "consumer_verification": "gh attestation verify <DMG> -R luceat-lux-vestra/crossinput"
  },
  "manual_live_readbacks": {
    "codeql": "CodeQL default-setup administration state requires repository administration read authority; custom CodeQL workflow remains the checked-in authority.",
    "actions/permissions": "Repository Actions execution policy is an administration surface; scheduled low-privilege audit records it as manual-unverified when unreadable.",
    "actions/permissions/workflow": "Default GITHUB_TOKEN workflow permissions are an administration surface; scheduled low-privilege audit records them as manual-unverified when unreadable."
  }
}
